<div class="page-title-row">
  <h1>Edit Test Plan</h1>
  <a href="/projects/{{project.slug}}/repos/{{repo.slug}}/plans/{{plan.id}}" class="btn btn-secondary">← Back</a>
</div>

<form action="/projects/{{project.slug}}/repos/{{repo.slug}}/plans/{{plan.id}}/edit" method="POST">
  <div style="display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start">
    <div class="card">
      <div class="card-header">
        <h2>Plan Details</h2>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label class="form-label">Plan Name *</label>
          <input class="form-control" name="name" value="{{plan.name}}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-control" name="description" rows="2">{{plan.description}}</textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select class="form-control" name="status">
            <option value="active" {{#if (eq plan.status 'active' )}}selected{{/if}}>Active</option>
            <option value="archived" {{#if (eq plan.status 'archived' )}}selected{{/if}}>Archived</option>
          </select>
        </div>
      </div>
    </div>

    <div class="card" style="position:sticky;top:calc(var(--nav-h) + 16px)">
      <div class="card-body">
        <div id="selection-count" style="font-size:0.875rem;color:var(--text-2);margin-bottom:12px">Loading…</div>
        <button type="submit" class="btn btn-primary" style="width:100%">Save Changes</button>
        <a href="/projects/{{project.slug}}/repos/{{repo.slug}}/plans/{{plan.id}}" class="btn btn-secondary"
          style="width:100%;margin-top:8px;justify-content:center">Cancel</a>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:16px">
    <div class="card-header">
      <h2>Select &amp; Order Test Cases</h2>
      <input type="text" class="form-control" id="case-search" placeholder="Search…" style="width:200px">
    </div>
    <div class="card-body" style="padding:0">
      <div class="plan-columns">

        <div style="border-right:1px solid var(--border);padding:16px">
          <div
            style="font-size:0.78rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">
            Available — click to add</div>
          {{#if testCases.length}}
          <div class="table-wrap">
            <table class="table table-sm case-table plan-table">
              <thead>
                <tr>
                  <th class="col-case">Test Case</th>
                  <th>Priority</th>
                  <th>Type</th>
                  <th class="col-actions"></th>
                </tr>
              </thead>
              <tbody id="available-list">
                {{#if ungroupedCases.length}}
                <tr class="table-group-row">
                  <td colspan="4">Ungrouped</td>
                </tr>
                {{#each ungroupedCases}}
                <tr class="plan-avail-card" data-id="{{id}}" data-title="{{title}}" data-priority="{{priority}}"
                  data-type="{{type}}">
                  <td class="col-case"><span class="case-title" title="{{title}}">{{title}}</span></td>
                  <td>
                    <span class="priority-badge {{priority}}"><span
                        class="priority-dot {{priority}}"></span>{{capitalize priority}}</span>
                  </td>
                  <td><span class="badge badge-gray">{{typeLabel type}}</span></td>
                  <td class="col-actions"><span class="plan-add-icon">+</span></td>
                </tr>
                {{/each}}
                {{/if}}

                {{#each groupedCases}}
                <tr class="table-group-row">
                  <td colspan="4">{{name}}</td>
                </tr>
                {{#each cases}}
                <tr class="plan-avail-card" data-id="{{id}}" data-title="{{title}}" data-priority="{{priority}}"
                  data-type="{{type}}">
                  <td class="col-case"><span class="case-title" title="{{title}}">{{title}}</span></td>
                  <td>
                    <span class="priority-badge {{priority}}"><span
                        class="priority-dot {{priority}}"></span>{{capitalize priority}}</span>
                  </td>
                  <td><span class="badge badge-gray">{{typeLabel type}}</span></td>
                  <td class="col-actions"><span class="plan-add-icon">+</span></td>
                </tr>
                {{/each}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{else}}
          <div class="empty-state" style="padding:24px">
            <h3>No test cases available</h3>
          </div>
          {{/if}}
        </div>

        <div style="padding:16px">
          <div
            style="font-size:0.78rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">
            Selected — drag to reorder</div>
          <div class="table-wrap">
            <table class="table table-sm case-table plan-table">
              <thead>
                <tr>
                  <th class="col-drag"></th>
                  <th class="col-order">#</th>
                  <th class="col-case">Test Case</th>
                  <th>Priority</th>
                  <th>Type</th>
                  <th class="col-actions"></th>
                </tr>
              </thead>
              <tbody id="selected-list" style="min-height:200px">
                <tr id="selected-empty">
                  <td colspan="6" class="plan-empty-cell">Click cases on the left to add them here</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div id="hidden-inputs"></div>
</form>

<script>
  var selectedIds = [];   // ordered list of case IDs
  var caseData = {};      // id -> {title, priority, type}

  // Build caseData map from available cards
  document.querySelectorAll('.plan-avail-card').forEach(function (card) {
    var id = card.dataset.id;
    caseData[id] = { title: card.dataset.title, priority: card.dataset.priority, type: card.dataset.type };
  });

  var preSelected = {{{ json selectedIds }}};
  preSelected.forEach(function (id) {
    id = String(id);
    if (caseData[id]) {
      selectedIds.push(id);
      var avail = document.querySelector('.plan-avail-card[data-id="' + id + '"]');
      if (avail) { avail.style.opacity = '0.4'; avail.style.pointerEvents = 'none'; }
    }
  });

  function renderSelected() {
    var list = document.getElementById('selected-list');
    var hidden = document.getElementById('hidden-inputs');
    var counter = document.getElementById('selection-count');

    // Clear hidden inputs
    hidden.innerHTML = '';
    selectedIds.forEach(function (id, i) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = 'case_ids'; inp.value = id;
      hidden.appendChild(inp);
      // sort_order handled server-side by array position
    });

    // Update counter
    if (counter) counter.textContent = selectedIds.length + ' case' + (selectedIds.length !== 1 ? 's' : '') + ' selected';

    // Empty state
    if (selectedIds.length === 0) {
      list.innerHTML = '<tr id="selected-empty"><td colspan="6" class="plan-empty-cell">Click cases on the left to add them here</td></tr>';
      return;
    }

    list.innerHTML = '';
    selectedIds.forEach(function (id, index) {
      var c = caseData[id] || { title: 'Case ' + id, priority: 'medium', type: 'functional' };
      var tr = document.createElement('tr');
      tr.className = 'plan-selected-card';
      tr.dataset.id = id;
      tr.draggable = true;
      tr.innerHTML =
        '<td class="col-drag"><span class="drag-handle" title="Drag to reorder">⠿</span></td>' +
        '<td class="col-order">' + (index + 1) + '</td>' +
        '<td class="col-case"><span class="case-title" title="' + escHtml(c.title) + '">' + escHtml(c.title) + '</span></td>' +
        '<td><span class="priority-badge ' + c.priority + '"><span class="priority-dot ' + c.priority + '"></span>' + cap(c.priority) + '</span></td>' +
        '<td><span class="badge badge-gray">' + cap(c.type) + '</span></td>' +
        '<td class="col-actions"><button type="button" class="btn btn-ghost btn-icon btn-sm remove-selected" data-id="' + id + '" title="Remove" style="color:var(--red)">✕</button></td>';
      list.appendChild(tr);
    });

    // Wire drag events
    initDragDrop();
  }

  function escHtml(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

  // Click available card to add
  document.getElementById('available-list').addEventListener('click', function (e) {
    var card = e.target.closest('.plan-avail-card');
    if (!card) return;
    var id = card.dataset.id;
    if (selectedIds.indexOf(id) === -1) {
      selectedIds.push(id);
      card.style.opacity = '0.4';
      card.style.pointerEvents = 'none';
      renderSelected();
    }
  });

  // Click remove button on selected card
  document.getElementById('selected-list').addEventListener('click', function (e) {
    var btn = e.target.closest('.remove-selected');
    if (!btn) return;
    var id = btn.dataset.id;
    selectedIds = selectedIds.filter(function (x) { return x !== id; });
    // Re-enable in available list
    var avail = document.querySelector('.plan-avail-card[data-id="' + id + '"]');
    if (avail) { avail.style.opacity = ''; avail.style.pointerEvents = ''; }
    renderSelected();
  });

  // Drag and drop reordering
  var dragSrcId = null;

  function initDragDrop() {
    document.querySelectorAll('.plan-selected-card').forEach(function (card) {
      card.addEventListener('dragstart', function (e) {
        dragSrcId = card.dataset.id;
        card.style.opacity = '0.4';
        e.dataTransfer.effectAllowed = 'move';
      });
      card.addEventListener('dragend', function () {
        card.style.opacity = '';
        document.querySelectorAll('.plan-selected-card').forEach(function (c) {
          c.classList.remove('drag-over');
        });
      });
      card.addEventListener('dragover', function (e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        document.querySelectorAll('.plan-selected-card').forEach(function (c) { c.classList.remove('drag-over'); });
        card.classList.add('drag-over');
      });
      card.addEventListener('drop', function (e) {
        e.preventDefault();
        if (dragSrcId === card.dataset.id) return;
        var srcIdx = selectedIds.indexOf(dragSrcId);
        var tgtIdx = selectedIds.indexOf(card.dataset.id);
        if (srcIdx === -1 || tgtIdx === -1) return;
        selectedIds.splice(srcIdx, 1);
        selectedIds.splice(tgtIdx, 0, dragSrcId);
        renderSelected();
      });
    });
  }

  // Search filter
  document.getElementById('case-search')?.addEventListener('input', function () {
    var q = this.value.toLowerCase();
    document.querySelectorAll('.plan-avail-card').forEach(function (card) {
      card.style.display = card.dataset.title.toLowerCase().includes(q) ? '' : 'none';
    });
    // Hide group headings that have no visible cases
    document.querySelectorAll('#available-list .table-group-row').forEach(function (groupRow) {
      var next = groupRow.nextElementSibling;
      var hasVisible = false;
      while (next && !next.classList.contains('table-group-row')) {
        if (next.classList.contains('plan-avail-card') && next.style.display !== 'none') {
          hasVisible = true;
          break;
        }
        next = next.nextElementSibling;
      }
      groupRow.style.display = hasVisible ? '' : 'none';
    });
  });

  // Initial render
  renderSelected();
</script>