<div class="page-title-row">
  <div>
    <h1>{{repo.name}}</h1>
    {{#if repo.description}}<p>{{repo.description}}</p>{{/if}}
  </div>
  <div class="btn-group">
    <button class="btn btn-secondary" data-modal="modal-edit-repo"><i class="bi bi-pencil"></i> Edit</button>
    <button class="btn btn-primary" data-modal="modal-new-case"><i class="bi bi-plus-lg"></i> New Test Case</button>
  </div>
</div>

<!-- Stats -->
<div class="stats-row">
  <div class="stat-card">
    <div class="stat-card-body">
      <div class="stat-label">Test Cases</div>
      <div class="stat-value">{{stats.totalCases}}</div>
      <div class="stat-meta"><span class="up">●</span> Repository coverage</div>
    </div>
    <div class="stat-icon"><i class="bi bi-bug"></i></div>
  </div>
  <div class="stat-card stat-cyan">
    <div class="stat-card-body">
      <div class="stat-label">Test Plans</div>
      <div class="stat-value">{{stats.totalPlans}}</div>
      <div class="stat-meta">Planning assets</div>
    </div>
    <div class="stat-icon cyan"><i class="bi bi-journal-text"></i></div>
  </div>
  <div class="stat-card stat-green">
    <div class="stat-card-body">
      <div class="stat-label">Total Runs</div>
      <div class="stat-value">{{stats.totalRuns}}</div>
      <div class="stat-meta">Execution history</div>
    </div>
    <div class="stat-icon green"><i class="bi bi-play-circle"></i></div>
  </div>
  <div class="stat-card stat-orange">
    <div class="stat-card-body">
      <div class="stat-label">Active Runs</div>
      <div class="stat-value">{{stats.activeRuns}}</div>
      <div class="stat-meta">{{#if stats.activeRuns}}<span class="up">In progress</span>{{else}}All clear{{/if}}</div>
    </div>
    <div class="stat-icon orange"><i class="bi bi-lightning-charge"></i></div>
  </div>
</div>

<!-- Priority / Type breakdown -->
{{#if testCases.length}}
<div class="card" style="margin-bottom:24px">
  <div class="card-body" style="display:flex;gap:24px;flex-wrap:wrap;align-items:center">
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
      <span style="font-size:0.78rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.04em">Priority</span>
      {{#each priorityStats}}
      <span class="priority-badge {{priority}}"><span class="priority-dot {{priority}}"></span>{{capitalize priority}} <strong>{{cnt}}</strong></span>
      {{/each}}
    </div>
    <div class="toolbar-sep" style="height:18px;background:var(--border);width:1px"></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
      <span style="font-size:0.78rem;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:0.04em">Type</span>
      {{#each typeStats}}
      <span class="badge badge-gray">{{typeLabel type}} {{cnt}}</span>
      {{/each}}
    </div>
  </div>
</div>
{{/if}}

<!-- Tabs -->
<div class="tab-set">
  <div class="tabs">
    <button class="tab-btn active" data-tab="tab-cases">Test Cases <span class="badge badge-gray" style="margin-left:4px" id="tab-cases-count">{{testCases.length}}</span></button>
    <button class="tab-btn" data-tab="tab-plans">Test Plans <span class="badge badge-gray" style="margin-left:4px">{{testPlans.length}}</span></button>
    <button class="tab-btn" data-tab="tab-runs">Test Runs <span class="badge badge-gray" style="margin-left:4px">{{testRuns.length}}</span></button>
  </div>

  <!-- Test Cases Tab -->
  <div class="tab-panel active" id="tab-cases">
    <div class="card">
      <div class="card-header">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <h2 style="margin:0">Test Cases</h2>
          <span class="badge badge-gray" id="case-count-badge">{{testCases.length}}</span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <input type="text" class="form-control" id="case-filter-search" placeholder="Search cases..." style="width:220px;min-width:160px">
          <button class="btn btn-secondary btn-sm" data-modal="modal-manage-groups">Groups</button>
          <button class="btn btn-primary btn-sm" data-modal="modal-new-case"><i class="bi bi-plus-lg"></i> New Test Case</button>
        </div>
      </div>
      <div style="padding:14px 20px;border-bottom:1px solid var(--border-light);background:#fbfcff">
        <div class="filter-bar" id="case-group-filters" style="margin-bottom:0">
          <button type="button" class="filter-chip active" data-group-filter="all">All <span class="count">{{testCases.length}}</span></button>
          <button type="button" class="filter-chip" data-group-filter="ungrouped">Ungrouped <span class="count" id="count-ungrouped">{{ungroupedCases.length}}</span></button>
          {{#each groups}}
          <button type="button" class="filter-chip" data-group-filter="{{id}}">{{name}} <span class="count" data-group-count="{{id}}">{{case_count}}</span></button>
          {{/each}}
        </div>
      </div>
      <div class="table-wrap">
        <table class="table table-sm case-table" id="repo-cases-table">
          <thead>
            <tr>
              <th class="col-order">S.No</th>
              <th class="col-case">Test Case</th>
              <th>Priority</th>
              <th>Type</th>
              <th>Status</th>
              <th class="col-group">Group</th>
              <th class="col-tags">Tags</th>
              <th class="col-actions"></th>
            </tr>
          </thead>
          <tbody id="repo-cases-tbody">
            {{#each testCases}}
            <tr class="case-row" data-case-id="{{id}}" data-group-id="{{#if group_id}}{{group_id}}{{else}}ungrouped{{/if}}" data-title="{{title}}" data-tags="{{tags}}">
              <td class="col-order case-sno">{{add @index 1}}</td>
              <td class="col-case">
                <a class="case-link" href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/cases/{{id}}" title="{{title}}">{{title}}</a>
                {{#if url}}<a class="case-url-link" href="{{url}}" target="_blank" rel="noopener" title="{{url}}">🔗</a>{{/if}}
              </td>
              <td><span class="priority-badge {{priority}}"><span class="priority-dot {{priority}}"></span>{{capitalize priority}}</span></td>
              <td><span class="badge badge-gray">{{typeLabel type}}</span></td>
              <td><span class="status-badge {{status}}">{{capitalize status}}</span></td>
              <td class="col-group"><span class="text-muted">{{or group_name '—'}}</span></td>
              <td class="col-tags">{{#if tags}}<span class="case-tags text-muted" title="{{tags}}">{{tags}}</span>{{else}}<span class="text-muted">—</span>{{/if}}</td>
              <td class="col-actions">
                <div class="btn-group">
                  <a href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/cases/{{id}}/edit" class="btn btn-ghost btn-icon btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                  <form action="/projects/{{../project.slug}}/repos/{{../repo.slug}}/cases/{{id}}/delete" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-ghost btn-icon btn-sm text-danger" title="Delete" data-confirm="Delete this test case?"><i class="bi bi-trash3"></i></button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}}
            <tr class="inline-add-row" id="inline-add-row" data-project="{{project.slug}}" data-repo="{{repo.slug}}">
              <td class="col-order" style="color:var(--text-3)">+</td>
              <td class="col-case"><input class="form-control" id="inline-case-title" placeholder="Quick add test case title..." maxlength="500"></td>
              <td>
                <select class="form-control" id="inline-case-priority">
                  <option value="medium">Medium</option><option value="critical">Critical</option><option value="high">High</option><option value="low">Low</option>
                </select>
              </td>
              <td>
                <select class="form-control" id="inline-case-type">
                  <option value="functional">Functional</option><option value="regression">Regression</option><option value="smoke">Smoke</option><option value="performance">Performance</option><option value="security">Security</option><option value="usability">Usability</option><option value="other">Other</option>
                </select>
              </td>
              <td>
                <select class="form-control" id="inline-case-status">
                  <option value="active">Active</option><option value="draft">Draft</option><option value="deprecated">Deprecated</option>
                </select>
              </td>
              <td class="col-group">
                <select class="form-control" id="inline-case-group">
                  <option value="">— No Group —</option>
                  {{#each groups}}
                  <option value="{{id}}">{{name}}</option>
                  {{/each}}
                </select>
              </td>
              <td class="col-tags"><input class="form-control" id="inline-case-tags" placeholder="Tags (comma separated)" maxlength="200"></td>
              <td class="col-actions"><div class="inline-add-actions"><button type="button" class="btn btn-primary btn-sm" id="inline-case-save">Add</button></div></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div id="case-filter-empty" class="empty-state" style="display:none;padding:28px">
        <h3>No matching test cases</h3>
        <p>Try a different filter or search term.</p>
      </div>
    </div>
  </div>

  <!-- Test Plans Tab -->
  <div class="tab-panel" id="tab-plans">
    <div style="display:flex;justify-content:flex-end;margin-bottom:14px">
      <a href="/projects/{{project.slug}}/repos/{{repo.slug}}/plans/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Plan</a>
    </div>
    {{#if testPlans.length}}
    <div class="card">
      <div class="table-wrap">
        <table class="table table-sm">
          <thead><tr>
            <th class="col-order">S.No</th><th>Name</th><th>Description</th><th>Cases</th><th>Status</th><th>Created</th><th></th>
          </tr></thead>
          <tbody>
          {{#each testPlans}}
          <tr>
            <td class="col-order">{{add @index 1}}</td>
            <td><a href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/plans/{{id}}" style="font-weight:500">{{name}}</a></td>
            <td style="color:var(--text-2);font-size:0.85rem">{{truncate description 60}}</td>
            <td><span class="badge badge-blue">{{case_count}}</span></td>
            <td><span class="status-badge {{status}}">{{statusLabel status}}</span></td>
            <td style="color:var(--text-3);font-size:0.82rem">{{formatDate created_at}}</td>
            <td>
              <a href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/plans/{{id}}" class="btn btn-ghost btn-sm">View</a>
            </td>
          </tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{else}}
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <h3>No test plans yet</h3>
      <p>Create a test plan to group test cases for a run</p>
    </div>
    {{/if}}
  </div>

  <!-- Test Runs Tab -->
  <div class="tab-panel" id="tab-runs">
    <div style="display:flex;justify-content:flex-end;margin-bottom:14px">
      <a href="/projects/{{project.slug}}/repos/{{repo.slug}}/runs/new" class="btn btn-primary btn-sm">+ New Run</a>
    </div>
    {{#if testRuns.length}}
    <div class="card">
      <div class="table-wrap">
        <table class="table table-sm">
          <thead><tr>
            <th class="col-order">S.No</th><th>Name</th><th>Plan</th><th>Environment</th><th>Progress</th><th>Status</th><th>Created</th><th></th>
          </tr></thead>
          <tbody>
          {{#each testRuns}}
          <tr>
            <td class="col-order">{{add @index 1}}</td>
            <td><a href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/runs/{{id}}" style="font-weight:500">{{name}}</a></td>
            <td style="color:var(--text-2);font-size:0.85rem">{{or plan_name '—'}}</td>
            <td>{{#if environment}}<span class="env-badge env-{{envClass environment}}">{{environment}}</span>{{else}}<span style="color:var(--text-3)">—</span>{{/if}}</td>
            <td style="min-width:120px">
              <div style="display:flex;align-items:center;gap:8px">
                <div class="progress-bar" style="flex:1;height:5px">
                  <div class="progress-fill" style="width:{{pct (add passed (add failed (add blocked skipped))) total}}%;background:{{#if failed}}var(--red){{else}}var(--green){{/if}}"></div>
                </div>
                <span style="font-size:0.75rem;color:var(--text-3)">{{add passed (add failed (add blocked skipped))}}/{{total}}</span>
              </div>
            </td>
            <td><span class="status-badge {{status}}">{{statusLabel status}}</span></td>
            <td style="color:var(--text-3);font-size:0.82rem">{{formatDate created_at}}</td>
            <td><a href="/projects/{{../project.slug}}/repos/{{../repo.slug}}/runs/{{id}}" class="btn btn-ghost btn-sm">Open</a></td>
          </tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{else}}
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-play-circle"></i></div>
      <h3>No test runs yet</h3>
      <p>Start a test run to execute test cases</p>
    </div>
    {{/if}}
  </div>
</div>

<!-- New Test Case Modal -->
<div class="modal-overlay" id="modal-new-case">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h2>New Test Case</h2>
      <button class="modal-close" data-close-modal="modal-new-case">✕</button>
    </div>
    <form action="/projects/{{project.slug}}/repos/{{repo.slug}}/cases" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Title *</label>
          <input class="form-control" name="title" placeholder="e.g. User can add item to cart" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Priority</label>
            <select class="form-control" name="priority">
              <option value="critical">🔴 Critical</option>
              <option value="high">🟠 High</option>
              <option value="medium" selected>🟡 Medium</option>
              <option value="low">⚪ Low</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Type</label>
            <select class="form-control" name="type">
              <option value="functional" selected>Functional</option>
              <option value="regression">Regression</option>
              <option value="smoke">Smoke</option>
              <option value="performance">Performance</option>
              <option value="security">Security</option>
              <option value="usability">Usability</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Group</label>
            <select class="form-control" name="group_id">
              <option value="">— Ungrouped —</option>
              {{#each groups}}
              <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-control" name="status">
              <option value="active" selected>Active</option>
              <option value="draft">Draft</option>
              <option value="deprecated">Deprecated</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">URL</label>
          <input class="form-control" name="url" placeholder="https://...">
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-control" name="description" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Preconditions</label>
          <textarea class="form-control" name="preconditions" rows="2" placeholder="What must be set up before running this test?"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Steps</label>
          <textarea class="form-control" name="steps" rows="4" placeholder="1. Navigate to...&#10;2. Click on...&#10;3. Verify that..."></textarea>
          <div class="form-hint">Enter each step on a new line</div>
        </div>
        <div class="form-group">
          <label class="form-label">Expected Result</label>
          <textarea class="form-control" name="expected_result" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <input class="form-control" name="tags" placeholder="login, auth, regression (comma-separated)">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="modal-new-case">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Test Case</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Repo Modal -->
<div class="modal-overlay" id="modal-edit-repo">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Repository</h2>
      <button class="modal-close" data-close-modal="modal-edit-repo">✕</button>
    </div>
    <form action="/projects/{{project.slug}}/repos/{{repo.slug}}/edit" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input class="form-control" name="name" value="{{repo.name}}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-control" name="description" rows="2">{{repo.description}}</textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" formaction="/projects/{{project.slug}}/repos/{{repo.slug}}/delete" formmethod="post"
          class="btn btn-danger btn-sm" style="margin-right:auto"
          data-confirm="Delete this repository and all its data?">Delete</button>
        <button type="button" class="btn btn-secondary" data-close-modal="modal-edit-repo">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Manage Groups Modal -->
<div class="modal-overlay" id="modal-manage-groups">
  <div class="modal">
    <div class="modal-header">
      <h2>Manage Groups</h2>
      <button class="modal-close" data-close-modal="modal-manage-groups">✕</button>
    </div>
    <div class="modal-body">
      {{#if groups.length}}
      <div style="margin-bottom:16px">
        {{#each groups}}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-light)">
          <span style="font-weight:500">{{name}}</span>
          <form action="/projects/{{../project.slug}}/repos/{{../repo.slug}}/groups/{{id}}/delete" method="POST" style="display:inline">
            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--red)" data-confirm="Delete this group? Cases won't be deleted.">✕</button>
          </form>
        </div>
        {{/each}}
      </div>
      {{/if}}
      <form action="/projects/{{project.slug}}/repos/{{repo.slug}}/groups" method="POST">
        <div style="display:flex;gap:8px">
          <input class="form-control" name="name" placeholder="New group name" required>
          <button type="submit" class="btn btn-primary" style="white-space:nowrap">Add Group</button>
        </div>
      </form>
    </div>
  </div>
</div>
